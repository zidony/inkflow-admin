{
  "name": "inkflow-admin",
  "version": "2.6.3",
  "description": "InkFlow Admin — Premium, Commercial-Grade Web Administration Template",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/assets/js/**/*.js\"",
    "lint:css": "stylelint \"src/assets/css/**/*.css\"",
    "check:html": "node scripts/check-html.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:responsive": "node scripts/check-responsive.mjs",
    "check:inline-styles": "node scripts/check-inline-styles.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:js-boundaries": "node scripts/check-js-boundaries.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:release": "npm run release:check",
    "format:check": "prettier --check \"src/assets/js/**/*.js\" \"src/assets/css/**/*.css\"",
    "quality": "npm run lint && npm run lint:css && npm run check:html && npm run check:a11y && npm run check:responsive && npm run check:inline-styles && npm run check:tokens && npm run check:i18n && npm run check:js-boundaries && npm run check:docs && npm run format:check",
    "lint:fix": "eslint \"src/assets/js/**/*.js\" --fix && stylelint \"src/assets/css/**/*.css\" --fix && prettier --write \"src/assets/js/**/*.js\" \"src/assets/css/**/*.css\"",
    "release:check": "node scripts/check-release.mjs",
    "release": "npm run build && node scripts/release.mjs && npm run release:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node test/e2e/smoke.mjs",
    "test:responsive": "node test/e2e/responsive.mjs"
  },
  "keywords": [
    "admin",
    "template",
    "dashboard",
    "bootstrap",
    "vite",
    "esm",
    "dark-mode"
  ],
  "author": "InkFlow Team",
  "license": "MIT",
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/plus-jakarta-sans": "^5.2.8",
    "chart.js": "^4.4.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "cssnano": "^7.0.1",
    "eslint": "^9.3.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-html": "^8.1.1",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^17.0.5",
    "postcss": "^8.4.38",
    "prettier": "^3.2.5",
    "stylelint": "^17.12.0",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^5.2.11",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-handlebars": "^2.0.3",
    "vitest": "^2.1.9"
  },
  "lint-staged": {
    "src/assets/css/**/*.css": "stylelint --fix",
    "src/assets/js/**/*.js": "eslint --fix"
  }
}
