{
  "name": "inkflow-admin",
  "version": "2.0.0",
  "description": "InkFlow Admin — Premium, Commercial-Grade Web Administration Template",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/assets/js/**/*.js\"",
    "lint:fix": "eslint \"src/assets/js/**/*.js\" --fix && prettier --write \"src/assets/js/**/*.js\" \"src/assets/css/**/*.css\" \"src/**/*.html\"",
    "release": "npm run build && python scripts/release.py"
  },
  "keywords": [
    "admin",
    "template",
    "dashboard",
    "bootstrap",
    "vite",
    "esm",
    "dark-mode"
  ],
  "author": "InkFlow Team",
  "license": "MIT",
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "cssnano": "^7.0.1",
    "eslint": "^9.3.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-html": "^8.1.1",
    "postcss": "^8.4.38",
    "prettier": "^3.2.5",
    "vite": "^5.2.11"
  }
}
